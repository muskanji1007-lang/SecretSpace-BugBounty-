# Server Port (default 5000)
PORT=5000

# MongoDB Connection String (Atlas URI in production e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/secretspace)
MONGODB_URI=mongodb://localhost:27017/secretspace

# Allowed Frontend Client URL (e.g. https://secret-space-psi.vercel.app or http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Secret for signing authentication JWT tokens (generate a long random secret)
JWT_SECRET=your_jwt_secret_key_here

# Token validity lifespan
JWT_EXPIRES_IN=7d
